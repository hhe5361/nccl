{
  "phase": "phase8",
  "name": "gpt_small_ddp_random_tokens",
  "description": "GPT-small scratch random-token DDP workload for phase6 W controller evaluation.",
  "run": {
    "run_id_prefix": "phase8_gpt_small_ddp",
    "master_server": "worker01",
    "master_addr": "172.16.0.101",
    "master_port": 40100,
    "all_workers": [
      "worker01",
      "worker02",
      "worker08",
      "worker07"
    ],
    "run_modes": [
      "stock",
      "p6_spike"
    ],
    "repeats": 1,
    "steps": 200,
    "warmup_steps": 20,
    "mode_timeout_sec": 0,
    "mode_delay_sec": 180,
    "torch_env": "/workspace/venvs/torch-cu132-custom/bin/activate",
    "target_script": "research/code/phase8/ddp_gpt_small.py",
    "worker_script": "research/code/phase4/run_b4_mode_worker.sh",
    "compare_script": "research/code/phase4/compare_b4_vs_stock.py",
    "summary_script": "research/code/phase4/phase4_ncc_event_summary.py",
    "summary_output_name": "phase8_ncc_event_summary.json"
  },
  "paths": {
    "log_root_base": "/mnt/nfs_share/cts_experiments",
    "host_repo_root": "",
    "remote_repo_root": "/home/{user}/hyoeun/nccl",
    "remote_repo_root_map": "",
    "container_repo_root": "/workspace/nccl",
    "network_topology_file": "research/env/network_topology_internal_ips.txt"
  },
  "container": {
    "name": "nccl-cu132-dev",
    "reset_at_start": 1,
    "restart_on_failure": 1
  },
  "ssh": {
    "worker_ssh_user": "",
    "worker_ssh_user_map": "",
    "worker_ssh_port": 14760,
    "worker_ssh_port_map": "",
    "ssh_connect_timeout_sec": 10
  },
  "model": {
    "dtype": "float32",
    "hidden_dim": 768,
    "num_layers": 12,
    "num_heads": 12,
    "seq_len": 128,
    "vocab_size": 50257,
    "dropout": 0.0,
    "batch_size": 1,
    "bucket_cap_mb": 4,
    "lr": 0.00005,
    "model_seed": 20260504
  },
  "nccl": {
    "algo": "Ring",
    "proto": "auto",
    "phase0_log": 1,
    "phase4_log": 0,
    "phase6_log": 1,
    "appendix2_group_log": 0,
    "debug": "INFO",
    "debug_subsys": "NET",
    "net_gdr_level": 0
  },
  "mode_matrix": [
    {
      "mode_id": "stock",
      "label": "STOCK",
      "phase4_enable": 0,
      "phase6_enable": 0,
      "post_receive_w": null
    },
    {
      "mode_id": "p6_spike",
      "label": "P6_SPIKE",
      "phase4_enable": 0,
      "phase6_enable": 1,
      "post_receive_w": null
    }
  ]
