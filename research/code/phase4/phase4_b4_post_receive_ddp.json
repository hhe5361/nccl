{
  "phase": "phase4",
  "name": "b4_post_received_ddp_tiny",
  "description": "Appendix-1 phase4 experiment with grouped recv path preserved, repeat support, and a probabilistic real-valued post-received < W gate.",
  "run": {
    "run_id_prefix": "phase4_b4_ddp",
    "master_server": "worker01",
    "master_addr": "172.16.0.101",
    "master_port": 40100,
    "all_workers": [
      "worker01",
      "worker02",
      "worker03",
      "worker04",
      "worker05",
      "worker06",
      "worker07",
      "worker08"
    ],
    "run_modes": [
      "stock",
      "b4_w2",
      "b4_w4",
      "b4_w6",
      "b4_w8"
    ],
    "repeats": 1,
    "steps": 50,
    "warmup_steps": 5,
    "mode_timeout_sec": 600,
    "torch_env": "/workspace/venvs/torch-cu121-custom/bin/activate",
    "target_script": "research/code/phase4/ddp_b4.py",
    "worker_script": "research/code/phase4/run_b4_mode_worker.sh",
    "compare_script": "research/code/phase4/compare_b4_vs_stock.py"
  },
  "paths": {
    "log_root_base": "/mnt/nfs_share/cts_experiments",
    "host_repo_root": "",
    "remote_repo_root": "/home/{user}/hyoeun/nccl",
    "remote_repo_root_map": "",
    "container_repo_root": "/workspace/nccl",
    "network_topology_file": "research/env/network_topology_internal_ips.txt"
  },
  "container": {
    "name": "nccl-cu121-dev",
    "reset_at_start": 1,
    "restart_on_failure": 1
  },
  "ssh": {
    "worker_ssh_user": "",
    "worker_ssh_user_map": "",
    "worker_ssh_port": 14760,
    "worker_ssh_port_map": "",
    "ssh_connect_timeout_sec": 10
  },
  "model": {
    "dtype": "float32",
    "hidden_dim": 1024,
    "num_layers": 4,
    "batch_size": 16,
    "bucket_cap_mb": 1,
    "lr": 0.01,
    "model_seed": 20260504
  },
  "nccl": {
    "algo": "Ring",
    "proto": "auto",
    "phase0_log": 1,
    "phase4_log": 0,
    "appendix2_group_log": 0,
    "debug": "INFO",
    "debug_subsys": "NET",
    "net_gdr_level": 0
  },
  "mode_matrix": [
    {
      "mode_id": "stock",
      "label": "STOCK",
      "phase4_enable": 0,
      "post_receive_w": null
    },
    {
      "mode_id": "b4_w2",
      "label": "B4_W2",
      "phase4_enable": 1,
      "post_receive_w": 2.0
    },
    {
      "mode_id": "b4_w4",
      "label": "B4_W4",
      "phase4_enable": 1,
      "post_receive_w": 4.0
    },
    {
      "mode_id": "b4_w6",
      "label": "B4_W6",
      "phase4_enable": 1,
      "post_receive_w": 6.0
    },
    {
      "mode_id": "b4_w8",
      "label": "B4_W8",
      "phase4_enable": 1,
      "post_receive_w": 8.0
    }
  ]
}
