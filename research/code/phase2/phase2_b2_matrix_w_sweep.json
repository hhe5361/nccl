{
  "phase": "phase2",
  "name": "b2_w_sweep_8node_master_orchestrated",
  "description": "8-node static receiver-window sweep with a master-orchestrated single-port launch model, persistent dev containers, STATUS_DDP worker status markers, and switch PFC logging.",
  "runner_contract": {
    "master_server": "worker01",
    "worker_pool": [
      "worker01",
      "worker02",
      "worker03",
      "worker04",
      "worker05",
      "worker06",
      "worker07",
      "worker08"
    ],
    "nnodes": 8,
    "nproc_per_node": 1,
    "master_addr": "172.16.0.101",
    "master_port": 40000,
    "network_topology_file": "research/env/network_topology_internal_ips.txt",
    "torch_env": "/workspace/venvs/torch-cu132-custom/bin/activate",
    "target_script": "research/code/phase2/collective_b2.py",
    "execution_model": "master_orchestrated_single_port",
    "ssh_user_resolution": {
      "default": "worker hostname itself",
      "global_override_env": "WORKER_SSH_USER",
      "per_worker_override_env": "WORKER_SSH_USER_MAP"
    },
    "ssh_host_resolution": {
      "default": "resolve worker internal IP from [Workers] section in research/env/network_topology_internal_ips.txt",
      "override_env": "NETWORK_TOPOLOGY_FILE"
    },
    "ssh_port_resolution": {
      "default": 22,
      "global_override_env": "WORKER_SSH_PORT",
      "per_worker_override_env": "WORKER_SSH_PORT_MAP"
    },
    "remote_repo_root_resolution": {
      "default": "if REMOTE_REPO_ROOT starts with /home/<user>/..., rewrite it to the resolved remote ssh user home",
      "global_override_env": "REMOTE_REPO_ROOT",
      "per_worker_override_env": "REMOTE_REPO_ROOT_MAP",
      "template_tokens": [
        "{worker}",
        "{user}"
      ]
    },
    "container_model": {
      "helper_script": "research/code/deploy/run_dev_container.sh",
      "container_name": "nccl-cu132-dev",
      "reset_at_matrix_start": true,
      "reset_per_experiment": false,
      "restart_on_failure": true
    },
    "status_contract": {
      "env_var": "STATUS_DDP",
      "meaning": {
        "1": "worker is in-flight",
        "0": "worker finished successfully and is about to exit",
        "-1": "worker failed"
      },
      "sync_file_pattern": ".ddp_status/<MODE>/<worker>.status"
    }
  },
  "payload": {
    "payload_mb": 128,
    "dtype": "float32",
    "steps": 40,
    "warmup_steps": 5,
    "mode_timeout_sec": 600
  },
  "switch_logging": {
    "enabled": true,
    "interval_sec": 1,
    "required_env": [
      "DPU_NODE_PWD",
      "NETWORK_NODE_PASSWORD",
      "SWITCH_PASSWORD"
    ],
    "optional_env": [
      "DPU_NODE_PORT",
      "NETWORK_NODE_PORT"
    ],
    "manual_ref": "research/docs/switch/switch_congestion_logger_manual.html"
  },
  "mode_matrix": [
    {
      "mode_id": "stock",
      "label": "STOCK",
      "policy": "baseline_nccl",
      "phase2_b2_enable": 0,
      "phase3_b3_enable": 0,
      "static_w": null
    },
    {
      "mode_id": "b2_w2",
      "label": "B2_W2",
      "policy": "static_receiver_window",
      "phase2_b2_enable": 0,
      "phase3_b3_enable": 0,
      "static_w": 2
    },
    {
      "mode_id": "b2_w4",
      "label": "B2_W4",
      "policy": "static_receiver_window",
      "phase2_b2_enable": 0,
      "phase3_b3_enable": 0,
      "static_w": 4
    },
    {
      "mode_id": "b2_w5",
      "label": "B2_W5",
      "policy": "static_receiver_window",
      "phase2_b2_enable": 0,
      "phase3_b3_enable": 0,
      "static_w": 5
    },
    {
      "mode_id": "b2_w6",
      "label": "B2_W6",
      "policy": "static_receiver_window",
      "phase2_b2_enable": 0,
      "phase3_b3_enable": 0,
      "static_w": 6
    },
    {
      "mode_id": "b2_w7",
      "label": "B2_W7",
      "policy": "static_receiver_window",
      "phase2_b2_enable": 0,
      "phase3_b3_enable": 0,
      "static_w": 7
    },
    {
      "mode_id": "b2_w8",
      "label": "B2_W8",
      "policy": "static_receiver_window",
      "phase2_b2_enable": 0,
      "phase3_b3_enable": 0,
      "static_w": 8
    }
  ],
  "workload_matrix": [
    {
      "experiment_id": "allreduce_ring_128mb",
      "collective": "allreduce",
      "nccl_algo": "Ring",
      "nccl_proto": "auto",
      "payload_mb": 128
    },
    {
      "experiment_id": "allreduce_tree_128mb",
      "collective": "allreduce",
      "nccl_algo": "Tree",
      "nccl_proto": "auto",
      "payload_mb": 128
    },
    {
      "experiment_id": "allgather_auto_128mb",
      "collective": "allgather",
      "nccl_algo": "auto",
      "nccl_proto": "auto",
      "payload_mb": 128
    },
    {
      "experiment_id": "reducescatter_auto_128mb",
      "collective": "reducescatter",
      "nccl_algo": "auto",
      "nccl_proto": "auto",
      "payload_mb": 128
    },
    {
      "experiment_id": "alltoall_auto_128mb",
      "collective": "alltoall",
      "nccl_algo": "auto",
      "nccl_proto": "auto",
      "payload_mb": 128
    }
  ],
  "report_requirements": {
    "input_arg": "--input-dir",
    "output_arg": "--output-dir",
    "switch_log_arg": "--switch-log",
    "required_png_plots": [
      "stock_vs_b2_throughput.png",
      "stock_vs_b2_latency.png",
      "stock_vs_b2_switch_pfc_counts.png",
      "stock_vs_b2_step_window_trace.png",
      "b2_matrix_latency.png",
      "b2_matrix_throughput.png",
      "b2_matrix_pfc_count.png",
      "b2_matrix_pfc_severity.png"
    ],
    "required_tables": [
      "stock_vs_b2_summary",
      "b2_workload_by_w_summary"
    ],
    "validation_fields": [
      "final_output_match_vs_stock",
      "final_output_match_workers"
    ]
  },
  "analysis_goals": [
    "Check whether static window reduction reduces in-flight traffic indicators.",
    "Check which workload and algorithm combinations show meaningful latency or throughput changes.",
    "Check whether switch PFC count and severity track with the window sweep.",
    "Confirm that each B2 mode preserves final output equivalence against STOCK."
  ]
}
