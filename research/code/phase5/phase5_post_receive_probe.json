{
  "phase": "phase5",
  "name": "phase5_post_receive_probe",
  "description": "Simple probe for POST->NET_DONE delay and recvProxyProgress cadence under the phase4 post-received<W gate.",
  "run": {
    "run_id_prefix": "phase5_post_receive_probe",
    "master_server": "worker01",
    "master_addr": "172.16.0.101",
    "master_port": 40200,
    "all_workers": [
      "worker01",
      "worker02",
      "worker03",
      "worker04",
      "worker05",
      "worker06",
      "worker07",
      "worker08"
    ],
    "run_modes": [
      "stock",
      "p5_w2"
    ],
    "repeats": 1,
    "steps": 20,
    "warmup_steps": 5,
    "mode_timeout_sec": 600,
    "torch_env": "/workspace/venvs/torch-cu132-custom/bin/activate",
    "target_script": "research/code/phase4/ddp_b4.py",
    "worker_script": "research/code/phase5/run_p5_mode_worker.sh",
    "compare_script": "research/code/phase4/compare_b4_vs_stock.py",
    "summary_script": "research/code/phase5/phase5_diag_summary.py",
    "summary_output_name": "phase5_diag_summary.json"
  },
  "paths": {
    "log_root_base": "/mnt/nfs_share/cts_experiments",
    "host_repo_root": "",
    "remote_repo_root": "/home/{user}/hyoeun/nccl",
    "remote_repo_root_map": "",
    "container_repo_root": "/workspace/nccl",
    "network_topology_file": "research/env/network_topology_internal_ips.txt"
  },
  "container": {
    "name": "nccl-cu132-dev",
    "reset_at_start": 1,
    "restart_on_failure": 1
  },
  "ssh": {
    "worker_ssh_user": "",
    "worker_ssh_user_map": "",
    "worker_ssh_port": 14750,
    "worker_ssh_port_map": "",
    "ssh_connect_timeout_sec": 10
  },
  "model": {
    "dtype": "float32",
    "hidden_dim": 1024,
    "num_layers": 4,
    "batch_size": 16,
    "bucket_cap_mb": 1,
    "lr": 0.01,
    "model_seed": 20260504
  },
  "nccl": {
    "algo": "Ring",
    "proto": "auto",
    "phase0_log": 0,
    "phase4_log": 0,
    "appendix2_group_log": 0,
    "debug": "INFO",
    "debug_subsys": "NET",
    "net_gdr_level": 0
  },
  "mode_matrix": [
    {
      "mode_id": "stock",
      "label": "STOCK",
      "phase4_enable": 0,
      "post_receive_w": 0
    },
    {
      "mode_id": "p5_w2",
      "label": "P5_W2",
      "phase4_enable": 1,
      "post_receive_w": 2
    }
  ]
}
