{
  "phase": "phase6",
  "name": "p6_spike_runtime_ddp",
  "description": "Runtime spike-based receiver-side W controller. Logs W timeline, POST-to-NET_DONE delay, internal throughput, and WSTALL ratio for switch PFC overlay.",
  "run": {
    "run_id_prefix": "phase6_pi_ddp",
    "master_server": "worker01",
    "master_addr": "172.16.0.101",
    "master_port": 40100,
    "all_workers": [
      "worker01",
      "worker02",
      "worker06",
      "worker07"
    ],
    "run_modes": [
      "stock",
      "p6_spike"
    ],
    "repeats": 2,
    "steps": 300,
    "warmup_steps": 20,
    "mode_timeout_sec": 1000,
    "mode_delay_sec": 180,
    "torch_env": "/workspace/venvs/torch-cu121-custom/bin/activate",
    "target_script": "research/code/phase4/ddp_b4.py",
    "worker_script": "research/code/phase4/run_b4_mode_worker.sh",
    "compare_script": "research/code/phase4/compare_b4_vs_stock.py"
  },
  "paths": {
    "log_root_base": "/mnt/nfs_share/cts_experiments",
    "host_repo_root": "",
    "remote_repo_root": "/home/{user}/hyoeun/nccl",
    "remote_repo_root_map": "",
    "container_repo_root": "/workspace/nccl",
    "network_topology_file": "research/env/network_topology_internal_ips.txt"
  },
  "container": {
    "name": "nccl-cu121-dev",
    "reset_at_start": 1,
    "restart_on_failure": 1
  },
  "ssh": {
    "worker_ssh_user": "",
    "worker_ssh_user_map": "",
    "worker_ssh_port": 14760,
    "worker_ssh_port_map": "",
    "ssh_connect_timeout_sec": 10
  },
  "model": {
    "dtype": "float32",
    "hidden_dim": 2048,
    "num_layers": 4,
    "batch_size": 16,
    "bucket_cap_mb": 1,
    "lr": 0.01,
    "model_seed": 20260504
  },
  "nccl": {
    "algo": "Ring",
    "proto": "auto",
    "phase0_log": 1,
    "phase4_log": 0,
    "phase6_log": 1,
    "appendix2_group_log": 0,
    "debug": "INFO",
    "debug_subsys": "NET",
    "net_gdr_level": 0
  },
  "mode_matrix": [
    {
      "mode_id": "stock",
      "label": "STOCK",
      "phase4_enable": 0,
      "phase6_enable": 0,
      "post_receive_w": null
    },
    {
      "mode_id": "p6_spike",
      "label": "P6_SPIKE",
      "phase4_enable": 0,
      "phase6_enable": 1,
      "post_receive_w": null
    }
  ]
}
